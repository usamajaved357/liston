# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Postgres
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/listing_automation_dev

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_real_env
JWT_EXPIRES_IN=7d

# Credential encryption (AES-256-GCM key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Transactional email (Resend) — used for verification/password-reset emails.
# Free tier, no domain verification needed for dev: sends only to the email
# address your Resend account was signed up with, from their shared test sender.
RESEND_API_KEY=
EMAIL_FROM=Liston <onboarding@resend.dev>

# Claude API (AI text generation)
ANTHROPIC_API_KEY=

# Image transformation (Bria primary / Photoroom fallback)
BRIA_API_KEY=
PHOTOROOM_API_KEY=

# Stripe (Phase 8 — not needed for local Phase 1 foundation testing yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sheets (Phase 7 — not needed yet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
