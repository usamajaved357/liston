# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Postgres
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/listing_automation_dev

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_real_env
JWT_EXPIRES_IN=7d

# Credential encryption (AES-256-GCM key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Transactional email (Resend) — used for verification/password-reset emails.
# Free tier, no domain verification needed for dev: sends only to the email
# address your Resend account was signed up with, from their shared test sender.
RESEND_API_KEY=
EMAIL_FROM=Liston <onboarding@resend.dev>

# Claude API (AI text generation)
ANTHROPIC_API_KEY=

# Image transformation (Bria primary / Photoroom fallback)
BRIA_API_KEY=
PHOTOROOM_API_KEY=

# Optional rotating-proxy service for the eBay/AliExpress scrapers (e.g.
# Bright Data, Oxylabs, ScraperAPI). Without one, scraping requests come from
# this server's own IP, which real anti-bot systems can rate-limit/block
# under sustained use. Format: "http://user:pass@proxy.host:port".
SCRAPER_PROXY_URL=

# eBay (Sell APIs) — Developer Portal: https://developer.ebay.com/my/keys
# RuName is registered there too, under "User Tokens" / "Get a Token from eBay via
# Your Application" — it maps to the actual OAuth redirect URL you configure.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENVIRONMENT=SANDBOX

# Marketplace Account Deletion/Closure Notification (mandatory for every
# production keyset) — Developer Portal: "Alerts & Notifications" tab.
# EBAY_DELETION_ENDPOINT_URL must be the exact public HTTPS URL you register
# there (e.g. https://your-domain.com/api/ebay/account-deletion) — no
# localhost/internal IPs, and it must match byte-for-byte, trailing slash
# included or not. EBAY_DELETION_VERIFICATION_TOKEN is a secret you generate
# yourself, 32-80 chars, alphanumeric/underscore/hyphen only, e.g.:
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# Stripe (Phase 8 — not needed for local Phase 1 foundation testing yet)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Sheets (Phase 7 — not needed yet)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
