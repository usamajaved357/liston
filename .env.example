# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Postgres
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/listing_automation_dev

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_real_env
JWT_EXPIRES_IN=7d

# Credential encryption (AES-256-GCM key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Transactional email (Resend) — used for verification/password-reset emails.
# Free tier, no domain verification needed for dev: sends only to the email
# address your Resend account was signed up with, from their shared test sender.
RESEND_API_KEY=
EMAIL_FROM=Liston <onboarding@resend.dev>

# Claude API (AI text generation)
ANTHROPIC_API_KEY=
# Access approval: comma-separated admin emails. Admins are auto-approved at
# signup and receive every access request with one-click approve/reject links.
ADMIN_EMAILS=you@example.com
# Public URL of this API, used to build those links (e.g. https://api.yourdomain.com)
API_URL=http://localhost:3000
# Model for every Claude call (draft writing, editor edits, image screening).
# Haiku by default — about a third of Sonnet's price and good enough here.
# AI_MODEL=claude-haiku-4-5-20251001

# Listing images are the supplier's photos, used as-is (replace them from the
# draft editor). Optional badges on the MAIN image only, all off by default —
# eBay's picture policy discourages badges/borders on listing images.
# IMAGE_ADD_UK_FLAG=false
# IMAGE_ADD_FREE_SHIPPING=false
# IMAGE_ADD_GLOW_BORDER=false

# eBay (Sell APIs) — Developer Portal: https://developer.ebay.com/my/keys
# RuName is registered there too, under "User Tokens" / "Get a Token from eBay via
# Your Application" — it maps to the actual OAuth redirect URL you configure.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_ENVIRONMENT=SANDBOX

# Marketplace Account Deletion/Closure Notification (mandatory for every
# production keyset) — Developer Portal: "Alerts & Notifications" tab.
# EBAY_DELETION_ENDPOINT_URL must be the exact public HTTPS URL you register
# there (e.g. https://your-domain.com/api/ebay/account-deletion) — no
# localhost/internal IPs, and it must match byte-for-byte, trailing slash
# included or not. EBAY_DELETION_VERIFICATION_TOKEN is a secret you generate
# yourself, 32-80 chars, alphanumeric/underscore/hyphen only, e.g.:
#   node -e "console.log(require('crypto').randomBytes(40).toString('hex'))"
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT_URL=

# AliExpress Dropshipping API — register a Dropshipping (individual) app at
# https://openservice.aliexpress.com, then run `node scripts/aliexpress-auth.js`
# once to authorise; tokens are kept in .cache/aliexpress-token.json and
# refreshed automatically. Set ALIEXPRESS_SOURCE=scraper to use Playwright instead.
ALIEXPRESS_SOURCE=ds-api
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_CALLBACK=https://your-domain.example/aliexpress/callback

# Only for scripts/copy-account.js (pulling or pushing one account between
# local and production). Never needed by the running app.
PROD_DATABASE_URL=
PROD_CREDENTIALS_ENCRYPTION_KEY=

# eBay Platform Notifications (optional). Public HTTPS URL of the backend's
# /api/ebay/notifications route, e.g. https://liston-production.up.railway.app/api/ebay/notifications
# After setting it, subscribe every connected account once:
#   node scripts/enable-ebay-notifications.js
EBAY_NOTIFICATIONS_URL=
# Dev ID from the same keyset in the Developer Portal; lets Liston verify
# each notification's signature.
EBAY_DEV_ID=
