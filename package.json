{
  "name": "liston",
  "version": "0.1.0",
  "description": "Liston — track competitor listings, generate original content with AI, publish across marketplaces",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js up",
