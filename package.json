    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.13.0",
    "ioredis": "^5.4.1",
    "bullmq": "^5.34.0",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "zod": "^3.23.8",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
